{
  "name": "typescript-monorepo-template",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "typescript",
    "monorepo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/typescript-monorepo-template.git"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "check:root": "pnpm run '/check:root:.*/'",
    "check:root:lint": "pnpm run z:eslint ./{scripts,configs}/**/*.mts --fix",
    "check:root:type": "tsc -p ./tsconfig.json --noEmit",
    "check-all": "tsx ./scripts/cmd/check-all.mts",
    "ci:publish": "pnpm run ws:build && pnpm changeset publish",
    "ci:version-packages": "pnpm changeset version && pnpm install --no-frozen-lockfile",
    "clean:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "codemod": "ts-codemod --uncommitted --transformer append-as-const --transformer convert-to-readonly 'packages/*/{src,scripts,samples,test}/**/*.{ts,mts,tsx}' && pnpm run fmt",
    "codemod:diff": "ts-codemod --diff-from origin/main --transformer append-as-const --transformer convert-to-readonly 'packages/*/{src,scripts,samples,test}/**/*.{ts,mts,tsx}' && pnpm run fmt",
    "codemod:full": "ts-codemod --transformer append-as-const --transformer convert-to-readonly 'packages/*/{src,scripts,samples,test}/**/*.{ts,mts,tsx}' && pnpm run fmt",
    "cspell": "cspell \"{**,.changeset/**/*,.github/**/*}\" --gitignore --gitignore-root ./ --no-progress",
    "fmt": "format-uncommitted",
    "fmt:diff": "format-diff-from origin/main",
    "fmt:full": "prettier --ignore-unknown --no-error-on-unmatched-pattern --write .",
    "md": "markdownlint-cli2",
    "prepare": "pnpm run z:link-strict-lib",
    "repo-settings:apply": "repo-settings apply",
    "repo-settings:backup": "repo-settings backup",
    "update-actions": "pnpm update --recursive --include-github-actions \"*/*\"",
    "update-packages": "pnpm update --latest --recursive",
    "ws:build": "tsx ./scripts/cmd/ws-build-stages.mts",
    "ws:check:ext": "pnpm run --recursive --if-present check:ext",
    "ws:doc": "pnpm run --recursive --if-present doc",
    "ws:doc:embed": "pnpm run --recursive --if-present doc:embed",
    "ws:doc:embed:jsdoc": "pnpm run --recursive --if-present doc:embed:jsdoc",
    "ws:gi": "pnpm run --recursive --if-present gi",
    "ws:lint": "pnpm run --recursive --if-present lint",
    "ws:lint:fix": "pnpm run --recursive --if-present lint:fix",
    "ws:test": "pnpm run --recursive --if-present test",
    "ws:test:browser": "pnpm run --recursive --if-present test:browser",
    "ws:test:cov": "pnpm run --recursive --if-present test:cov",
    "ws:tsc": "pnpm run --recursive --if-present tsc",
    "ws:type-check": "pnpm run --recursive --if-present type-check",
    "z:eslint": "NODE_OPTIONS='--max-old-space-size=6144' TIMING=1 eslint",
    "z:link-strict-lib": "strict-ts-lib-v7.0-link"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-strip": "3.0.4",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "26.4.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "cspell": "10.1.1",
    "eslint": "10.9.1",
    "eslint-config-typed": "5.11.2",
    "eslint-plugin-ts-data-forge": "0.7.0",
    "eslint-plugin-ts-fortress": "1.2.0",
    "eslint-plugin-ts-type-forge": "0.8.1",
    "github-settings-as-code": "3.0.2",
    "jiti": "2.7.0",
    "markdownlint": "0.41.1",
    "markdownlint-cli2": "0.23.2",
    "npm-run-all2": "9.0.3",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "rollup": "4.63.1",
    "rollup-plugin-esbuild": "6.2.1",
    "strict-ts-lib-v7.0": "0.6.2",
    "ts-codemod-cli": "^2.1.0",
    "ts-codemod-lib": "3.3.1",
    "ts-data-forge": "14.6.3",
    "ts-repo-utils": "10.6.0",
    "ts-type-forge": "9.2.2",
    "tslib": "2.8.1",
    "tsx": "4.23.12",
    "typedoc": "0.28.20",
    "typedoc-github-theme": "0.4.0",
    "typedoc-plugin-markdown": "4.13.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "25.9.0"
  }
}
